# Pathly Backend Environment Variables
# Copy this file to .env and fill in your actual values

# NVIDIA NIM API for curriculum generation
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=gpt-oss-120b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# JWT Secret for authentication tokens
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_a_long_random_string

# OpenRouter API for AI explanations and hints
OPENROUTE_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# YouTube API for video search in curriculum
YOUTUBE_API_KEY=your_youtube_api_key_here

# Qdrant vector database for semantic search
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redis for leaderboard (optional - graceful degradation if not set)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database (SQLite for local development)
# DATABASE_URL=sqlite:///./pathly.db
